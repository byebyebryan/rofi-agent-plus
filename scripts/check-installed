                }
            },
            "sessions": [
                {
                    "id": "synthetic-provider-row",
                    "kind": "codex",
                    "sourceObservation": "retained",
                }
            ],
            "errors": [
                {
                    "host": "alpha",
                    "stage": "codex",
                    "message": "synthetic provider-stage evidence",
                }
            ],
        }

    def __call__(
        self,
        executable: str,
        args: Sequence[str],
        environment: Mapping[str, str],
    ) -> subprocess.CompletedProcess[str]:
        self.calls.append((executable, tuple(args), dict(environment)))
        return _fake_result(executable, args, self.payload)


class _FakeCallbackRunner:
    """Scripted callback output used only by ``--self-test``."""

    def __init__(self, *, invalid_input: bool = False) -> None:
        self.calls: list[tuple[str, tuple[str, ...], Mapping[str, str]]] = []
        self.invalid_input = invalid_input

    def __call__(
        self,
        executable: str,
        args: Sequence[str],
        environment: Mapping[str, str],
    ) -> subprocess.CompletedProcess[str]:
        self.calls.append((executable, tuple(args), dict(environment)))
        name = Path(executable).name
        retv = environment.get("ROFI_RETV")
        labels = {
            "rofi-tmux-plus": ("Tmux › All", "Tmux › Local", "Open", "Kill"),
            "rofi-agent-plus": ("Agents › All", "Agents › Local", "Resume", "Close"),
        }
        initial, peer, primary, secondary = labels.get(
            name, ("SSH", "SSH", "Connect", "Forget recent history")
        )
        action = primary
        if name == "rofi-ssh-plus" and retv in {"16", "17"}:
            prompt = initial
            action = secondary if retv == "16" else primary
            data = "action:forget" if retv == "16" else "action:connect"
            preservation = "\x00keep-filter\x1ftrue\x1e\x00keep-selection\x1ftrue\x1e"
        elif name == "rofi-ssh-plus" and retv in {"10", "11", "12"}:
            prompt = initial
            data = "action:connect"
            preservation = "\x00keep-filter\x1ftrue\x1e\x00keep-selection\x1ftrue\x1e"
        elif name != "rofi-ssh-plus" and retv in {"16", "17"}:
            prompt = initial
            if name == "rofi-agent-plus":
                order = ("Resume", "Close", "New")
                previous = environment.get("ROFI_DATA", "")
                index = (
                    int(previous.removeprefix("state:action:"))
                    if previous.startswith("state:action:")
                    else 0
                )
                index = (index + (1 if retv == "16" else -1)) % len(order)
                action = order[index]
                data = f"state:action:{index}"
            else:
                action = secondary if retv == "16" else primary
                data = "state:secondary" if retv == "16" else "state:primary"
            preservation = "\x00keep-filter\x1ftrue\x1e\x00keep-selection\x1ftrue\x1e"
        elif retv == "11":
            prompt = peer
            data = "state:right"
            preservation = "\x00keep-filter\x1ftrue\x1e"
            if name in {"rofi-agent-plus", "rofi-tmux-plus"}:
                preservation += "\x00keep-selection\x1ftrue\x1e\x00new-selection\x1f0\x1e"
        elif retv == "12":
            prompt = initial
            data = "state:left"
            preservation = "\x00keep-filter\x1ftrue\x1e"
            if name in {"rofi-agent-plus", "rofi-tmux-plus"}:
                preservation += "\x00keep-selection\x1ftrue\x1e\x00new-selection\x1f0\x1e"
        else:
            prompt = initial
            data = "state:initial"
            preservation = ""
        no_custom = "\x00no-custom\x1ftrue\x1e" if name == "rofi-ssh-plus" else ""
        message = f"\x00message\x1f{_expected_action_line(name, action)}\x1e"
        if name == "rofi-ssh-plus" and retv == "0":
            initial_output = (
                f"\x00prompt\x1f{prompt}\n"
                f"\x00message\x1f{_expected_action_line(name, action)}\n"
                "\x00no-custom\x1ftrue\n"
                f"\x00data\x1f{data}\n"
                "\x00delim\x1f\\t\n"
                'row\x00info\x1f{"version":1,"kind":"host","id":"row"}'
                "\x00meta\x1frow\x00display\x1frow\nrecent\t"
            )
        else:
            initial_output = (
                f"\x00prompt\x1f{prompt}\x1e{message}{no_custom}"
                f"\x00data\x1f{data}\x1e{preservation}row\x1e"
            )
        return subprocess.CompletedProcess(
            [executable, *args],
            0,
            initial_output,
            "invalid_input" if self.invalid_input else "",
        )


class _FakeActivePageRunner:
    """Model explicit page writes separately from initial dialog reads."""

    def __init__(self, *, remembers: bool = True) -> None:
        self.remembers = remembers
        self.page = "All"

    def __call__(
        self,
        executable: str,
        args: Sequence[str],
        environment: Mapping[str, str],
    ) -> subprocess.CompletedProcess[str]:
        retv = environment.get("ROFI_RETV")
        if retv in {"11", "12"}:
            ring = ("Active", "Open", "All", "Local")
            current = environment.get("ROFI_DATA", f"page:{self.page}").removeprefix("page:")
            direction = 1 if retv == "11" else -1
            page = ring[(ring.index(current) + direction) % len(ring)]
        else:
            page = self.page
        if self.remembers and retv in {"11", "12"}:
            self.page = page
        preservation = (
            "\x00keep-filter\x1ftrue\x1e\x00new-selection\x1f0\x1e" if retv in {"11", "12"} else ""
        )
        output = (
            f"\x00prompt\x1fAgents › {page}\x1e"
            f"\x00message\x1f{_expected_action_line('rofi-agent-plus', 'Resume')}\x1e"
            f"\x00data\x1fpage:{page}\x1e{preservation}row\x1e"
            + ("All open sessions (0)\x1e" if page == "Open" else "")
        )
        return subprocess.CompletedProcess([executable, *args], 0, output, "")


def _self_test_require(condition: bool, message: str) -> None:
    if not condition:
        raise CheckError("self-test assertion failed: " + message)


def _self_test_no_forbidden_agent_commands(
    calls: Sequence[tuple[str, Sequence[str], Mapping[str, str]]],
    expected_executable: str,
) -> None:
    forbidden = {"open", "--open", "--defer-until-attached", "--cwd", "--command"}
    providers = {"codex", "claude", "opencode", "provider"}
    for executable, args, environment in calls:
        _self_test_require(
            executable == expected_executable, "fake used an installed Agent executable"
        )
        _self_test_require(tuple(args) == ("refresh",), "Agent refresh used an unexpected argv")
        _self_test_require(not forbidden.intersection(args), "forbidden Agent argument appeared")
        _self_test_require(
            not providers.intersection(token.casefold() for token in args),
            "provider command appeared in Agent argv",
        )
        _self_test_require("ROFI_RETV" not in environment, "Agent refresh inherited ROFI_RETV")


def _self_test() -> int:
    mesh = {
        "schemaVersion": 1,
        "meshRevision": "sha256:selftest",
        "localHostId": "alpha",
        "hosts": [
            {"id": "alpha", "local": True},
            {"id": "beta", "local": False},
        ],
    }
    host_ids, local_id, revision = _mesh_hosts(mesh)
    _self_test_require(host_ids == ("alpha", "beta"), "mesh host order was not retained")
    _self_test_require(
        local_id == "alpha" and revision == "sha256:selftest", "mesh metadata changed"
    )

    with TemporaryDirectory(prefix="rofi-plus-history-selftest-") as directory:
        history_path = Path(directory) / "history.json"
        history_payload = {
            "version": 1,
            "sortMode": "recency",
            "hosts": [{"host": "alpha", "lastConnected": 10, "count": 2}],
        }
        history_path.write_text(json.dumps(history_payload, indent=2), encoding="utf-8")
        history_before = _history_snapshot(history_path)
        history_path.write_text(
            json.dumps(
                {"hosts": history_payload["hosts"], "sortMode": "recency", "version": 1},
                separators=(",", ":"),
            ),
            encoding="utf-8",
        )
        _assert_history_unchanged(history_before, history_path)
        changed = dict(history_payload)
        changed["hosts"] = [{"host": "alpha", "lastConnected": 10, "count": 3}]
        history_path.write_text(json.dumps(changed), encoding="utf-8")
        try:
            _assert_history_unchanged(history_before, history_path)
        except CheckError as error:
            _self_test_require("history changed" in str(error), "history mutation was not detected")
        else:
            raise CheckError("self-test assertion failed: history mutation was accepted")
        missing_path = Path(directory) / "missing.json"
        missing = _history_snapshot(missing_path)
        _self_test_require(not missing.present, "missing history was not represented distinctly")
        missing_path.write_text(json.dumps(history_payload), encoding="utf-8")
        try:
            _assert_history_unchanged(missing, missing_path)
        except CheckError:
            pass
        else:
            raise CheckError("self-test assertion failed: missing history matched present history")
    print("[ok] SSH usage history comparison is semantic and distinguishes missing state")

    agent_runner = _FakeAgentRunner()
    agent_errors = _check_agent_contract(
        "/fake/rofi-agent-plus",
        revision,
        {"ROFI_RETV": "15", "PATH": "/fake"},
        host_ids=host_ids,
        runner=agent_runner,
    )
    _self_test_require(agent_errors == 1, "provider-stage evidence was not retained")
    _self_test_no_forbidden_agent_commands(agent_runner.calls, "/fake/rofi-agent-plus")
    wrong_backend = dict(agent_runner.payload)
    wrong_backend["backend"] = {
        "kind": "legacy",
        "capability": "legacy-v1",
        "meshRevision": None,
    }
    try:
        _agent_contract_snapshot(wrong_backend, revision)
    except CheckError:
        pass
    else:
        raise CheckError("self-test assertion failed: legacy Agent identity was accepted")
    malformed_last_refresh = json.loads(json.dumps(agent_runner.payload))
    malformed_last_refresh["lastRefresh"] = {
        "attemptedAt": 1,
        "completedAt": None,
        "outcome": "partial",
    }
    try:
        _agent_contract_snapshot(malformed_last_refresh, revision)
    except CheckError as error:
        _self_test_require(
            "lastRefresh" in str(error),
            "malformed Agent lastRefresh was not rejected",
        )
    else:
        raise CheckError("self-test assertion failed: malformed Agent lastRefresh was accepted")
    malformed_observations = json.loads(json.dumps(agent_runner.payload))
    malformed_observations["hosts"]["alpha"]["observations"]["tmux"] = {
        "lastAttemptAt": 1,
        "lastSuccessAt": 1,
        "outcome": "invented",
    }
    try:
        _agent_contract_snapshot(malformed_observations, revision)
    except CheckError as error:
        _self_test_require(
            "tmux observation" in str(error),
            "malformed Agent observation was not rejected",
        )
    else:
        raise CheckError("self-test assertion failed: malformed Agent observation was accepted")
    malformed_provenance = json.loads(json.dumps(agent_runner.payload))
    malformed_provenance["sessions"][0]["sourceObservation"] = "unproven"
    try:
        _agent_contract_snapshot(malformed_provenance, revision)
    except CheckError as error:
        _self_test_require(
            "sourceObservation" in str(error),
            "malformed Agent provenance was not rejected",
        )
    else:
        raise CheckError("self-test assertion failed: malformed Agent provenance was accepted")
    print(
        "[ok] Agent refresh proves contract identity and validates selected observation provenance"
    )

    callbacks = _FakeCallbackRunner()
    environment = {
        "ROFI_RETV": "7",
        "ROFI_INFO": "stale",
        "ROFI_INPUT": "stale",
        "ROFI_DATA": "stale",
        "ROFI_OUTSIDE": "stale",
    }
    _check_view_navigation(
        "rofi-agent-plus", "/fake/rofi-agent-plus", environment, runner=callbacks
    )
    _check_action_cycle("rofi-agent-plus", "/fake/rofi-agent-plus", environment, runner=callbacks)
    for _executable, args, environment in callbacks.calls:
        _self_test_require(not args, "callback probe passed unexpected argv")
        allowed = (
            {"ROFI_RETV"} if environment.get("ROFI_RETV") == "0" else {"ROFI_RETV", "ROFI_DATA"}
        )
        _self_test_require(
            set(environment).isdisjoint(set(ROFI_CALLBACK_VARS) - allowed),
            "stale callback variables retained",
        )
    _check_agent_active_page("/fake/rofi-agent-plus", {}, runner=_FakeActivePageRunner())
    try:
        _check_agent_active_page(
            "/fake/rofi-agent-plus", {}, runner=_FakeActivePageRunner(remembers=False)
        )
    except CheckError:
        pass
    else:
        raise CheckError("missing page restoration was accepted")
    print("[ok] owner contract and guard self-test")
    return 0


def _live(lifecycle=False, legacy_callbacks=False):
    before = _history_snapshot(_history_path())
    try:
        environment = _clean_environment()
        ssh = _resolve("rofi-ssh-plus")
        host_ids, local_id, revision = _check_mesh(ssh, environment)
        executable = _resolve(OWNER_COMMAND)
        with TemporaryDirectory(prefix="owner-picker-state-") as state:
            environment = dict(environment, XDG_STATE_HOME=state, XDG_CACHE_HOME=state + "/cache")
            _check_agent_contract(executable, revision, environment, host_ids=host_ids)
            _check_view_navigation(OWNER_COMMAND, executable, environment)
            _check_action_cycle(OWNER_COMMAND, executable, environment)
            if legacy_callbacks:
                _check_agent_active_page(executable, environment)
                _check_agent_group_target(executable, environment)
    finally:
        _assert_history_unchanged(before, _history_path())
    print("[ok] installed owner contract checks; graphical/provider acceptance is separate")
    return 0


def main():
    global AGENT_SNAPSHOT_VERSION, AGENT_OBSERVATION_STAGES
    import argparse

    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--self-test", action="store_true")
    mode.add_argument("--live", action="store_true")
    parser.add_argument(
        "--lifecycle",
        action="store_true",
        help="Tmux only: explicitly exercise owned disposable native sessions",
    )
    parser.add_argument(
        "--legacy-callbacks",
        action="store_true",
        help="Agent only: exercise the historical viewer/group contract",
    )
    parser.add_argument(
        "--legacy-profile", action="store_true", help="explicit Carbon/foreground cache-v4 profile"
    )
    args = parser.parse_args()
    if args.legacy_profile:
        AGENT_SNAPSHOT_VERSION = 4
        AGENT_OBSERVATION_STAGES = ("codex", "claude", "opencode", "activity", "tmux")
    if args.lifecycle and (OWNER_COMMAND != "rofi-tmux-plus" or not args.live):
        parser.error("--lifecycle requires Tmux --live")
    if args.legacy_callbacks and (OWNER_COMMAND != "rofi-agent-plus" or not args.live):
        parser.error("--legacy-callbacks requires Agent --live")
    try:
        return _self_test() if args.self_test else _live(args.lifecycle, args.legacy_callbacks)
    except (CheckError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"[error] {_compact(error)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
