#!/usr/bin/env python3
"""Install the direct picker and its development tools in the selected Python."""

import argparse
import subprocess
import sys
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args()
    subprocess.run(
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            "-e",
            str(Path(__file__).resolve().parents[1]) + "[dev]",
        ],
        check=True,
    )


if __name__ == "__main__":
    main()
