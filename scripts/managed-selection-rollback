#!/usr/bin/env python3
"""Capture and restore owned Agent Plus selectors and optional UI state."""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
from pathlib import Path

SOURCES = (
    "dot_local/bin/symlink_rofi-agent-plus.tmpl",
    "dot_local/bin/symlink_rofi-agent-plus-rofi.tmpl",
    "dot_config/rofi/scripts/symlink_agent-plus.tmpl",
)
LINKS = (
    ".local/bin/rofi-agent-plus",
    ".local/bin/rofi-agent-plus-rofi",
    ".config/rofi/scripts/agent-plus",
)
STATES = (".cache/rofi-agent-plus", ".local/state/rofi-agent-plus")


def fingerprint(path):
    if path.is_symlink():
        return {"link": os.readlink(path)}
    if not path.exists():
        return None
    if path.is_file() and path.stat().st_uid == os.getuid():
        return {"sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
    raise ValueError("unowned_or_unsupported_path")


def state_fingerprint(home):
    result = {}
    for relative in STATES:
        directory = home / relative
        if directory.exists():
            if directory.is_symlink() or directory.stat().st_uid != os.getuid():
                raise ValueError("unowned_state_directory")
            for path in directory.rglob("*"):
                if path.is_symlink():
                    raise ValueError("state_symlink")
                if path.is_file():
                    result[str(path.relative_to(home))] = fingerprint(path)
    return result


def private_json(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")
    path.chmod(0o600)


def owned(directory):
    if directory.resolve(strict=True) != directory or directory.stat().st_uid != os.getuid():
        raise ValueError("backup_ownership_changed")
    if directory.stat().st_mode & 0o077:
        raise ValueError("backup_not_private")


def capture(directory, home, source, revision):
    directory.mkdir(mode=0o700)
    owned(directory)
    saved = {
        "home": str(home),
        "source": str(source),
        "links": {name: fingerprint(home / name) for name in LINKS},
        "sources": {},
        "state": state_fingerprint(home),
    }
    for name in SOURCES:
        if revision:
            value = subprocess.run(
                ["git", "-C", str(source), "show", revision + ":" + name],
                capture_output=True,
                check=False,
            )
            data = value.stdout if value.returncode == 0 else None
        else:
            path = source / name
            data = path.read_bytes() if path.exists() else None
        saved["sources"][name] = None if data is None else hashlib.sha256(data).hexdigest()
        if data is not None:
            target = directory / "source" / name
            target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            target.write_bytes(data)
            target.chmod(0o600)
    for name in saved["state"]:
        target = directory / "state" / name
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.copyfile(home / name, target)
        target.chmod(0o600)
    private_json(directory / "before.json", saved)


def arm(directory, home, source):
    private_json(
        directory / "after.json",
        {
            "links": {name: fingerprint(home / name) for name in LINKS},
            "sources": {name: fingerprint(source / name) for name in SOURCES},
            "state": state_fingerprint(home),
        },
    )


def rollback(directory, home, source, restore_state):
    before = json.loads((directory / "before.json").read_text())
    after = json.loads((directory / "after.json").read_text())
    if any(value is not None and set(value) != {"link"} for value in before["links"].values()):
        raise ValueError("prior_selector_was_not_symlink")
    if before["home"] != str(home) or before["source"] != str(source):
        raise ValueError("backup_scope_changed")
    if {name: fingerprint(home / name) for name in LINKS} != after["links"]:
        raise ValueError("selected_links_changed_since_arm")
    if {name: fingerprint(source / name) for name in SOURCES} != after["sources"]:
        raise ValueError("managed_sources_changed_since_arm")
    if restore_state and state_fingerprint(home) != after["state"]:
        raise ValueError("consumer_state_changed_since_arm")
    for name, expected in before["sources"].items():
        if expected is not None and fingerprint(directory / "source" / name) != {
            "sha256": expected
        }:
            raise ValueError("backup_source_changed")
    if restore_state:
        for name, expected in before["state"].items():
            if fingerprint(directory / "state" / name) != expected:
                raise ValueError("backup_state_changed")
    for name, expected in before["sources"].items():
        path = source / name
        if expected is None:
            path.unlink(missing_ok=True)
        else:
            shutil.copyfile(directory / "source" / name, path)
    for name, expected in before["links"].items():
        path = home / name
        path.unlink(missing_ok=True)
        if expected is not None:
            path.symlink_to(expected["link"])
    if restore_state:
        for name in after["state"]:
            (home / name).unlink()
        for name in before["state"]:
            target = home / name
            target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            shutil.copyfile(directory / "state" / name, target)
            target.chmod(0o600)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("capture", "arm", "rollback"))
    parser.add_argument("--directory", type=Path, required=True)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--source-revision")
    parser.add_argument("--restore-state", action="store_true")
    args = parser.parse_args()
    home = Path.home()
    source = args.source.resolve(strict=True)
    if args.command == "capture":
        capture(args.directory, home, source, args.source_revision)
    else:
        owned(args.directory)
        if args.command == "arm":
            arm(args.directory, home, source)
        else:
            rollback(args.directory, home, source, args.restore_state)
    print(json.dumps({"status": "accepted", "operation": args.command, "providerOperations": 0}))


if __name__ == "__main__":
    main()
