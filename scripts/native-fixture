#!/usr/bin/env python3
"""Prepare and clean a same-host, private native home for explicit proofs."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import time
import uuid
from pathlib import Path


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")
    path.chmod(0o600)


def private_root(root):
    if not root.is_absolute() or root.resolve() != root:
        raise RuntimeError("fixture_path_not_canonical")
    info = root.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError("fixture_root_not_private")
    manifest = json.loads((root / "fixture.json").read_text())
    if manifest.get("root") != str(root) or manifest.get("uid") != os.getuid():
        raise RuntimeError("fixture_ownership_changed")
    return manifest


def process(pid):
    try:
        path = Path(f"/proc/{pid}")
        if path.stat().st_uid != os.getuid():
            raise RuntimeError("process_owner_changed")
        fields = (path / "stat").read_text().rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return {
            "pid": pid,
            "ticks": fields[19],
            "boot": Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
        }
    except FileNotFoundError:
        return None


def env_for(root, provider):
    env = dict(os.environ)
    env.update(HOME=str(root / "user"), XDG_CACHE_HOME=str(root / "cache"))
    env.pop("CODEX_PLUS_SOCKET", None)
    env["CODEX_HOME" if provider == "codex" else "CLAUDE_CONFIG_DIR"] = str(root / "native")
    return env


def ordinary_runtime(ordinary):
    """Observe only the three declared ordinary homes, without a process scan."""
    identities = {}
    for home in (ordinary / ".codex", ordinary / ".codex-work"):
        pidfile = home / "app-server-daemon/daemon.pid"
        if pidfile.is_file():
            identity = process(json.loads(pidfile.read_text())["pid"])
            if identity:
                identities[str(home)] = identity
    if shutil.which("claude"):
        env = dict(os.environ, HOME=str(ordinary), CLAUDE_CONFIG_DIR=str(ordinary / ".claude"))
        result = subprocess.run(
            ["claude", "daemon", "status"], env=env, capture_output=True, text=True, timeout=5
        )
        match = re.search(r"^pid:\s+(\d+)", result.stdout, re.M)
        if match:
            identity = process(int(match[1]))
            if identity:
                identities[str(ordinary / ".claude")] = identity
    return identities


def prepare(root, provider, label, helper, auth_home=None):
    root = root.absolute()
    if root.resolve() != root:
        raise RuntimeError("fixture_path_not_canonical")
    root.mkdir(mode=0o700, parents=True, exist_ok=False)
    info = root.lstat()
    incarnation = (info.st_dev, info.st_ino)
    try:
        _prepare_new_root(root, provider, label, helper, auth_home)
    except BaseException:
        current = root.lstat()
        if (current.st_dev, current.st_ino) == incarnation and not root.is_symlink():
            shutil.rmtree(root)
        raise


def _prepare_new_root(root, provider, label, helper, auth_home=None):
    ordinary = Path(pwd.getpwuid(os.getuid()).pw_dir)
    native = root / "native"
    for name in ("native", "user", "cache", "workspace", "bin"):
        (root / name).mkdir(mode=0o700)
    source = auth_home or ordinary / (".codex" if provider == "codex" else ".claude")
    auth = source / ("auth.json" if provider == "codex" else ".credentials.json")
    version_result = subprocess.run(
        [provider, "--version"], capture_output=True, text=True, timeout=5
    )
    version_match = re.search(r"[0-9]+\.[0-9]+\.[0-9]+", version_result.stdout)
    version = version_match.group() if version_match else "unknown"
    copied = []
    if auth.is_file():
        target = native / auth.name
        shutil.copyfile(auth, target)
        target.chmod(0o600)
        copied.append(str(target.relative_to(root)))
    if provider == "codex":
        (native / "config.toml").write_text(
            "[features]\ndaemon_auto_start = true\n[projects."
            + json.dumps(str(root / "workspace"))
            + ']\ntrust_level = "trusted"\n'
        )
        now = dt.datetime.now(dt.UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")
        sessions = native / "sessions" / dt.datetime.now(dt.UTC).strftime("%Y/%m/%d")
        sessions.mkdir(mode=0o700, parents=True)
        for letter in ("A", "B"):
            session = str(uuid.uuid4())
            message = f"Owned {label} {letter}"
            rows = [
                {
                    "timestamp": now,
                    "type": "session_meta",
                    "payload": {
                        "id": session,
                        "timestamp": now,
                        "cwd": str(root / "workspace"),
                        "originator": "codex_cli_rs",
                        "cli_version": version,
                        "source": "cli",
                        "model_provider": "openai",
                    },
                },
                {
                    "timestamp": now,
                    "type": "response_item",
                    "payload": {
                        "type": "message",
                        "role": "user",
                        "content": [{"type": "input_text", "text": message}],
                    },
                },
                {
                    "timestamp": now,
                    "type": "event_msg",
                    "payload": {"type": "user_message", "message": message, "images": []},
                },
            ]
            path = sessions / ("rollout-" + now.replace(":", "-") + "-" + session + ".jsonl")
            path.write_text("".join(json.dumps(row) + "\n" for row in rows))
            path.chmod(0o600)
    else:
        source_state = ordinary / ".claude.json"
        original = json.loads(source_state.read_text()) if source_state.exists() else {}
        selected = {
            key: original[key]
            for key in (
                "oauthAccount",
                "hasCompletedOnboarding",
                "lastOnboardingVersion",
                "theme",
                "userID",
                "numStartups",
            )
            if key in original
        }
        selected["projects"] = {
            str(root / "workspace"): {
                "hasTrustDialogAccepted": True,
                "hasCompletedProjectOnboarding": True,
            }
        }
        save(native / ".claude.json", selected)
        save(root / "user/.claude.json", selected)
        save(
            native / "settings.json",
            {"disableAllHooks": True, "enabledPlugins": {}, "disableAgentView": False},
        )
    config = root / "direct.toml"
    config.write_text(
        "schema_version = 1\n[[environments]]\nprovider = "
        + json.dumps(provider)
        + "\nhome = "
        + json.dumps(str(native))
        + "\nlabel = "
        + json.dumps("Owned " + label)
        + "\n"
    )
    mesh_command = shutil.which("rofi-ssh-plus")
    if mesh_command:
        mesh_wrapper = root / "bin/rofi-ssh-plus"
        mesh_wrapper.write_text(
            "#!/bin/sh\nexport PATH="
            + shlex.quote(str(root / "bin") + ":" + os.environ.get("PATH", ""))
            + "\nexport HOME="
            + shlex.quote(str(ordinary))
            + "\nexec "
            + shlex.quote(mesh_command)
            + ' "$@"\n'
        )
        mesh_wrapper.chmod(0o700)
    wrapper = root / "host-helper"
    interpreter = helper.parent / "python"
    helper_argv = (
        [str(interpreter), "-I", "-B", str(helper)] if interpreter.is_file() else [str(helper)]
    )
    wrapper.write_text(
        "#!/bin/sh\nexport PATH="
        + shlex.quote(str(root / "bin") + ":" + os.environ.get("PATH", ""))
        + "\nexport HOME="
        + shlex.quote(str(root / "user"))
        + "\nexport XDG_CONFIG_HOME="
        + shlex.quote(str(ordinary / ".config"))
        + "\nexport XDG_CACHE_HOME="
        + shlex.quote(str(root / "cache"))
        + "\nunset PYTHONPATH PYTHONHOME\nexec "
        + shlex.join(helper_argv)
        + ' "$@"\n'
    )
    wrapper.chmod(0o700)
    tracked = [
        ordinary / ".codex/config.toml",
        ordinary / ".codex-work/config.toml",
        ordinary / ".claude/settings.json",
    ]
    hashes = {
        str(path): hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None
        for path in tracked
    }
    global_state = ordinary / ".claude.json"
    global_keys = (
        {
            key: hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
            for key, value in json.loads(global_state.read_text()).items()
        }
        if global_state.exists()
        else {}
    )
    manifest = {
        "schemaVersion": 1,
        "runId": uuid.uuid4().hex,
        "root": str(root),
        "uid": os.getuid(),
        "provider": provider,
        "version": version,
        "label": label,
        "credentials": copied,
        "ordinaryHashes": hashes,
        "ordinaryGlobalKeys": global_keys,
        "ordinaryRuntime": ordinary_runtime(ordinary),
        "processes": [],
        "stopped": False,
    }
    save(root / "fixture.json", manifest)
    print(
        json.dumps(
            {
                "prepared": str(root),
                "provider": provider,
                "credentialsCopied": bool(copied),
                "helper": str(wrapper),
            }
        )
    )


def observe(root):
    state = private_root(root)
    provider = state["provider"]
    argv = (
        ["codex", "app-server", "daemon", "version"]
        if provider == "codex"
        else ["claude", "daemon", "status"]
    )
    result = subprocess.run(
        argv, env=env_for(root, provider), capture_output=True, timeout=8, text=True
    )
    pid = None
    if provider == "codex":
        path = root / "native/app-server-daemon/daemon.pid"
        if path.is_file():
            pid = json.loads(path.read_text()).get("pid")
    else:
        match = re.search(r"^pid:\s+(\d+)", result.stdout, re.M)
        if match:
            pid = int(match[1])
    identity = process(pid) if isinstance(pid, int) else None
    if identity:
        environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        expected = (
            ("CODEX_HOME" if provider == "codex" else "CLAUDE_CONFIG_DIR")
            + "="
            + str(root / "native")
        )
        if expected.encode() not in environ:
            raise RuntimeError("daemon_native_home_not_owned")
        state["processes"] = [identity]
    save(root / "fixture.json", state)
    print(json.dumps({"ownedDaemon": identity, "nativeStatusExit": result.returncode}))
    return state


def cleanup(root):
    state = private_root(root)
    for identity in state["processes"]:
        current = process(identity["pid"])
        if current is not None and current != identity:
            raise RuntimeError("fixture_incarnation_changed")
    state = observe(root)
    provider = state["provider"]
    argv = (
        ["codex", "app-server", "daemon", "stop"]
        if provider == "codex"
        else ["claude", "daemon", "stop", "--any"]
    )
    # Native scoped stop is allowed only for the unique prepared home. No PID
    # signalling or whole-host daemon termination is ever used here.
    result = subprocess.run(argv, env=env_for(root, provider), capture_output=True, timeout=20)
    deadline = time.monotonic() + 10
    while (
        any(process(item["pid"]) == item for item in state["processes"])
        and time.monotonic() < deadline
    ):
        time.sleep(0.1)
    if any(process(item["pid"]) == item for item in state["processes"]):
        raise RuntimeError("owned_daemon_still_running")
    for name in state["credentials"]:
        path = root / name
        if not path.is_relative_to(root / "native") or path.is_symlink():
            raise RuntimeError("credential_cleanup_scope_changed")
        path.unlink(missing_ok=True)
    hashes = {
        name: hashlib.sha256(Path(name).read_bytes()).hexdigest() if Path(name).is_file() else None
        for name in state["ordinaryHashes"]
    }
    if hashes != state["ordinaryHashes"]:
        raise RuntimeError("ordinary_configuration_changed")
    ordinary = Path(pwd.getpwuid(os.getuid()).pw_dir)
    if ordinary_runtime(ordinary) != state.get("ordinaryRuntime", {}):
        raise RuntimeError("ordinary_daemon_generation_changed")
    global_state = Path(pwd.getpwuid(os.getuid()).pw_dir) / ".claude.json"
    global_keys = (
        {
            key: hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
            for key, value in json.loads(global_state.read_text()).items()
        }
        if global_state.exists()
        else {}
    )
    baseline_keys = state.get("ordinaryGlobalKeys", {})
    changed_keys = sorted(
        key
        for key in set(global_keys) | set(baseline_keys)
        if global_keys.get(key) != baseline_keys.get(key)
    )
    if set(changed_keys) - {"promptQueueUseCount", "pluginUsage"}:
        raise RuntimeError("ordinary_configuration_changed")
    state.update(
        stopped=True,
        credentialsRemoved=True,
        ordinaryConfigurationPreserved=True,
        nativeStopExit=result.returncode,
        concurrentRuntimeChanges=changed_keys,
    )
    save(root / "fixture.json", state)
    print(
        json.dumps(
            {
                "stopped": str(root),
                "credentialsRemoved": True,
                "ordinaryConfigurationPreserved": True,
            }
        )
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("prepare", "observe", "cleanup"))
    parser.add_argument("root", type=Path)
    parser.add_argument("--provider", choices=("codex", "claude"))
    parser.add_argument("--label", default="proof")
    parser.add_argument("--helper", type=Path)
    parser.add_argument("--auth-home", type=Path)
    args = parser.parse_args()
    if args.command == "prepare":
        if args.provider is None or args.helper is None or not args.helper.is_absolute():
            parser.error("prepare requires provider and absolute helper")
        prepare(args.root, args.provider, args.label, args.helper, args.auth_home)
    elif args.command == "observe":
        observe(args.root)
    else:
        cleanup(args.root)


if __name__ == "__main__":
    main()
