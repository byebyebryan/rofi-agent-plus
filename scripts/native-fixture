#!/usr/bin/env python3
"""Owned native-proof fixture; no ordinary session operations or provider payload logging."""

import fcntl
import hashlib
import json
import os
import pty
import select
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import termios
import time
from pathlib import Path

OBSERVER = Path("/home/bryan/.local/share/agent-observer/0.2.0a3-6aa793e6a0ba5ae3")
PLUS = Path("/home/bryan/.local/share/rofi-agent-plus/0.14.0a1-8ba19a0eba87944a")
ORDINARY = Path("/home/bryan")


def save(path, value):
    path.write_text(json.dumps(value) + "\n")
    path.chmod(0o600)


def ticks(pid):
    return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]


def environment(root, host):
    base = root / ("native-" + host)
    return {
        "HOME": str(base / "home"),
        "CODEX_HOME": str(base / "codex"),
        "CLAUDE_CONFIG_DIR": str(base / "claude"),
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "PATH": f"{root}/bin:{OBSERVER}/bin:{PLUS}/bin:{ORDINARY}/.local/bin:/usr/bin:/bin",
        "XDG_CONFIG_HOME": str(base / "config"),
        "XDG_CACHE_HOME": str(base / "cache"),
        "XDG_STATE_HOME": str(base / "state"),
        "XDG_RUNTIME_DIR": str(base / "runtime"),
        "TMUX_TMPDIR": str(base / "runtime"),
        "NATIVE_PROOF_ROOT": str(root),
        "NATIVE_PROOF_HOST": host,
    }


def prepare(root, host):
    assert root.resolve() == root and root.stat().st_uid == os.getuid()
    base = root / ("native-" + host)
    base.mkdir(mode=0o700)
    for name in (
        "codex",
        "claude",
        "home",
        "workspace",
        "config",
        "cache",
        "state",
        "runtime",
        "terminals",
    ):
        (base / name).mkdir(mode=0o700)
    (root / "bin").mkdir(mode=0o700)
    source = Path(__file__).resolve()
    if source != root / "native-fixture":
        shutil.copyfile(source, root / "native-fixture")
    for role in ("ssh", "systemd-run", "terminal"):
        script = (
            '#!/usr/bin/python3\nimport os,sys\nos.execv("/usr/bin/python3", ["python3", "-I", '
            + repr(str(root / "native-fixture"))
            + ", "
            + repr(role)
            + ", "
            + repr(str(root))
            + ", *sys.argv[1:]])\n"
        )
        path = root / "bin" / role
        path.write_text(script)
        path.chmod(0o700)
    shutil.copyfile(ORDINARY / ".codex/auth.json", base / "codex/auth.json")
    (base / "codex/auth.json").chmod(0o600)
    config = (
        'model = "gpt-6.1-sol"\napproval_policy = "never"\nsandbox_mode = "danger-full-access"\n[features]\ndaemon_auto_start = true\n[projects.'
        + json.dumps(str(base / "workspace"))
        + ']\ntrust_level = "trusted"\n'
    )
    (base / "codex/config.toml").write_text(config)
    version = "0.160.0-x86_64-unknown-linux-musl"
    cache = base / "codex/packages/app-server-daemon"
    cache.mkdir(parents=True)
    shutil.copytree(
        ORDINARY / ".codex/packages/app-server-daemon/releases" / version,
        cache / "releases" / version,
    )
    (cache / "current").symlink_to("releases/" + version)
    if host == "snap":
        shutil.copyfile(ORDINARY / ".claude/.credentials.json", base / "claude/.credentials.json")
        (base / "claude/.credentials.json").chmod(0o600)
        original = json.loads((ORDINARY / ".claude.json").read_text())
        private = {
            key: original[key]
            for key in (
                "oauthAccount",
                "hasCompletedOnboarding",
                "lastOnboardingVersion",
                "theme",
                "userID",
                "numStartups",
            )
            if key in original
        }
        private["projects"] = {
            str(base / "workspace"): {
                "hasTrustDialogAccepted": True,
                "hasCompletedProjectOnboarding": True,
            }
        }
        save(base / "home/.claude.json", private)
        save(base / "claude/.claude.json", private)
        save(
            base / "claude/settings.json",
            {"disableAgentView": False, "disableAllHooks": True, "enabledPlugins": {}},
        )
        for name in ("sessions", "jobs", "daemon"):
            (base / "claude" / name).mkdir(mode=0o700)
    subprocess.run(["git", "init", "-q", str(base / "workspace")], check=True)
    for command in ("rofi-ssh-plus", "rofi-tmux-plus"):
        directory = base / "config" / command
        directory.mkdir()
        if command == "rofi-ssh-plus":
            config = (ORDINARY / ".config/rofi-ssh-plus/config.toml").read_text()
            config = config.replace(
                'executable = "ssh"', "executable = " + json.dumps(str(root / "bin/ssh"))
            )
        else:
            config = (
                "schema_version = 1\nterminal = ["
                + json.dumps(str(root / "bin/terminal"))
                + "]\nattach_timeout_seconds = 60\n"
            )
        (directory / "config.toml").write_text(config)
    save(root / "fixture.json", {"root": str(root), "host": host, "prepared": True})
    print(
        json.dumps(
            {"privateStorePrepared": True, "hostScope": host, "ordinaryConfigChanged": False}
        )
    )


def init(root, host):
    anchor = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    subprocess.run(["mount", "--make-rprivate", "/"], check=True)
    subprocess.run(["mount", "-t", "tmpfs", "-o", "mode=1777,size=1G", "tmpfs", "/tmp"], check=True)
    root.mkdir(parents=True)
    subprocess.run(
        ["mount", "--no-canonicalize", "--bind", f"/proc/{os.getpid()}/fd/{anchor}", str(root)],
        check=True,
    )
    os.close(anchor)
    base = root / ("native-" + host)
    mounts = [(base / "codex", ORDINARY / ".codex")]
    if host == "snap":
        mounts += [
            (base / "claude", ORDINARY / ".claude"),
            (base / "home/.claude.json", ORDINARY / ".claude.json"),
        ]
    for source, target in mounts:
        subprocess.run(["mount", "--bind", str(source), str(target)], check=True)
    save(
        root / "ready.json",
        {
            "uid": os.getuid(),
            "pid": os.getpid(),
            "ordinaryProviderPathsMasked": True,
            "privateTmp": True,
        },
    )
    while True:
        time.sleep(1)


def start(root, host):
    if root.resolve() != root or root.stat().st_uid != os.getuid():
        raise RuntimeError("fixture_ownership_changed")
    if (root / "runtime.json").exists():
        previous = json.loads((root / "runtime.json").read_text())
        if not previous.get("stopped"):
            raise RuntimeError("fixture_must_be_stopped_before_restart")
    (root / "ready.json").unlink(missing_ok=True)
    child = subprocess.Popen(
        [
            "unshare",
            "--user",
            "--map-root-user",
            "--mount",
            "--pid",
            "--fork",
            "--mount-proc",
            "/usr/bin/python3",
            "-I",
            str(root / "native-fixture"),
            "init",
            str(root),
            host,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if (root / "ready.json").exists():
            pids = Path(f"/proc/{child.pid}/task/{child.pid}/children").read_text().split()
            pid = int(pids[0])
            save(
                root / "runtime.json",
                {
                    "pid": pid,
                    "ticks": ticks(pid),
                    "namespaces": {
                        name: os.readlink(f"/proc/{pid}/ns/{name}")
                        for name in ("user", "mnt", "pid")
                    },
                    "host": host,
                },
            )
            print(
                json.dumps(
                    {
                        "isolationEstablished": json.loads((root / "ready.json").read_text()),
                        "hostScope": host,
                    }
                )
            )
            return
        if child.poll() is not None:
            raise RuntimeError("namespace_failed")
        time.sleep(0.1)
    child.kill()
    raise RuntimeError("namespace_timeout")


def current(root):
    if root.resolve() != root or root.stat().st_uid != os.getuid():
        raise RuntimeError("fixture_ownership_changed")
    state = json.loads((root / "runtime.json").read_text())
    if state.get("stopped"):
        raise RuntimeError("fixture_stopped")
    pid = state["pid"]
    if ticks(pid) != state["ticks"] or any(
        os.readlink(f"/proc/{pid}/ns/{name}") != value
        for name, value in state["namespaces"].items()
    ):
        raise RuntimeError("fixture_incarnation_changed")
    return state


def enter(root, argv):
    state = current(root)
    values = environment(root, state["host"])
    clean = ["PYTHONPATH", "TMUX", "DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "WAYLAND_DISPLAY"]
    env = ["env"]
    for name in clean:
        env += ["-u", name]
    env += [key + "=" + value for key, value in values.items()]
    os.execv(
        "/usr/bin/nsenter",
        [
            "nsenter",
            "--preserve-credentials",
            "-t",
            str(state["pid"]),
            "-U",
            "-m",
            "-p",
            "--",
            *env,
            *argv,
        ],
    )


def ssh(root, argv):
    mapping = json.loads((root / "peer.json").read_text())
    # All proof SSH calls carry a final shell command. Preserve configured route
    # and options; only wrap execution in the already owned peer namespace.
    target = argv[-2]
    if target != mapping["route"]:
        raise RuntimeError("unexpected_proof_route")
    remote = shlex.join(
        [
            "/usr/bin/python3",
            "-I",
            mapping["script"],
            "enter",
            mapping["root"],
            "--",
            "sh",
            "-c",
            argv[-1],
        ]
    )
    os.execv(
        "/usr/bin/ssh",
        [
            "ssh",
            "-F",
            str(ORDINARY / ".ssh/config"),
            *mapping.get("resolvedSshOptions", []),
            *argv[:-1],
            remote,
        ],
    )


def terminal(root, argv):
    assert argv[0] == "-e"
    base = root / ("native-" + os.environ["NATIVE_PROOF_HOST"])
    key = hashlib.sha256(json.dumps(argv).encode()).hexdigest()[:24]
    endpoint = base / "terminals" / (key + ".sock")
    server = socket.socket(socket.AF_UNIX)
    server.bind(str(endpoint))
    server.listen(4)
    server.setblocking(False)
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(argv[1], argv[1:])
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))
    os.set_blocking(fd, False)
    save(base / "terminals" / (key + ".json"), {"endpoint": str(endpoint), "argv": argv[1:]})
    deadline = time.monotonic() + 480
    try:
        while time.monotonic() < deadline:
            ready, _, _ = select.select([server, fd], [], [], 0.2)
            if fd in ready:
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                if b"\x1b[6n" in data:
                    os.write(fd, b"\x1b[1;1R")
                if b"\x1b[c" in data:
                    os.write(fd, b"\x1b[?1;2c")
            if server in ready:
                connection, _ = server.accept()
                request = json.loads(connection.recv(4096))
                if "write" in request:
                    os.write(fd, request["write"].encode())
                connection.sendall(b"{}")
                connection.close()
                if request.get("close"):
                    break
    finally:
        try:
            os.kill(pid, signal.SIGHUP)
            os.waitpid(pid, 0)
        except ProcessLookupError:
            pass
        os.close(fd)
        server.close()
        endpoint.unlink(missing_ok=True)


def control(root, request):
    host = json.loads((root / "fixture.json").read_text())["host"]
    base = root / ("native-" + host)
    entries = sorted((base / "terminals").glob("*.json"), key=lambda p: p.stat().st_mtime_ns)
    endpoint = json.loads(entries[-1].read_text())["endpoint"]
    client = socket.socket(socket.AF_UNIX)
    client.connect(endpoint)
    client.sendall(json.dumps(request).encode())
    client.recv(4096)
    client.close()


def stop(root):
    state = current(root)
    os.kill(state["pid"], signal.SIGKILL)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if not Path(f"/proc/{state['pid']}/ns/pid").exists():
            state["stopped"] = True
            save(root / "runtime.json", state)
            print(json.dumps({"ownedNamespaceStopped": True}))
            return
        time.sleep(0.05)
    raise RuntimeError("owned_namespace_stop_timeout")


def main():
    role, root, *args = sys.argv[1:]
    root = Path(root)
    if role == "prepare":
        prepare(root, args[0])
    elif role == "init":
        init(root, args[0])
    elif role == "start":
        start(root, args[0])
    elif role == "enter":
        enter(root, args[1:] if args[0] == "--" else args)
    elif role == "ssh":
        ssh(root, args)
    elif role == "systemd-run":
        command = args[args.index("--") + 1 :]
        os.execvp(command[0], command)
    elif role == "terminal":
        terminal(root, args)
    elif role == "control":
        control(root, json.loads(args[0]))
    elif role == "stop":
        stop(root)
    else:
        raise RuntimeError("invalid_role")


if __name__ == "__main__":
    main()
