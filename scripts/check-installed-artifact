#!/usr/bin/env python3
"""Verify an explicit unselected wheel installation outside the checkout."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pwd
import subprocess
import tempfile
import zipfile
from pathlib import Path, PurePosixPath

ENTRY_POINTS = {
    "rofi-agent-plus": "rofi_agent_plus.app:main",
    "rofi-agent-plus-rofi": "rofi_agent_plus.launcher:main",
    "rofi-agent-plus-host": "rofi_agent_plus.host:main",
    "rofi-agent-plus-viewer": "rofi_agent_plus.viewer:main",
}
RETIRED = {
    "observer_contract",
    "observer_write",
    "contract_backend",
    "contract_lifecycle",
    "contract_viewers",
    "viewer_state",
    "session_identity",
    "batch",
}


def require(condition, message):
    if not condition:
        raise ValueError(message)


def wheel_files(path):
    with zipfile.ZipFile(path) as archive:
        names = archive.namelist()
        require(len(names) == len(set(names)) and len(names) < 4096, "duplicate/oversized wheel")
        for name in names:
            relative = PurePosixPath(name)
            require(
                not relative.is_absolute() and ".." not in relative.parts and "\\" not in name,
                "unsafe wheel path",
            )
        package = {
            name: archive.read(name) for name in names if name.startswith("rofi_agent_plus/")
        }
        require(bool(package), "missing package")
        require(not any(Path(name).stem in RETIRED for name in package), "retired runtime in wheel")
        return package


def inspect(prefix, wheel, output):
    require(
        prefix.is_absolute() and prefix.resolve() == prefix and prefix.stat().st_uid == os.getuid(),
        "candidate prefix ownership",
    )
    python = prefix / "bin/python"
    require(python.is_file(), "missing candidate interpreter")
    package = wheel_files(wheel)
    output.mkdir(mode=0o700, parents=True, exist_ok=False)
    with tempfile.TemporaryDirectory(prefix="agent-plus-artifact-") as temporary:
        root = Path(temporary)
        poison = root / "rofi_agent_plus"
        poison.mkdir()
        (poison / "__init__.py").write_text("raise RuntimeError('checkout/PYTHONPATH imported')\n")
        bin_dir = root / "bin"
        bin_dir.mkdir()
        log = root / "provider-calls.jsonl"
        fake = (
            "#!"
            + str(python)
            + "\n"
            + """import json,os,sys
from pathlib import Path
with Path(os.environ['PROOF_LOG']).open('a') as stream: stream.write(json.dumps(sys.argv[1:])+'\\n')
if Path(sys.argv[0]).name == 'claude': assert 'CLAUDE_CONFIG_DIR' not in os.environ
if sys.argv[1:]==['agents','--help']: print('native agents manager')
elif sys.argv[1:]==['app-server','daemon','version']: print('daemon socket: No such file or directory (os error 2)',file=sys.stderr);sys.exit(1)
elif sys.argv[1:]==['daemon','status']: print('pid: 42\\ncontrol.sock: reachable')
else: raise RuntimeError('unexpected provider call')
"""
        )
        (bin_dir / "codex").write_text(fake)
        (bin_dir / "codex").chmod(0o700)
        (bin_dir / "claude").write_text(fake)
        (bin_dir / "claude").chmod(0o700)
        for command in ("rofi-tmux-plus", "agent-observer", "tmux", "niri", "kitty"):
            script = bin_dir / command
            script.write_text(
                "#!"
                + str(python)
                + "\nraise RuntimeError('retired or graphical dependency called')\n"
            )
            script.chmod(0o700)
        config = root / "direct.toml"
        config.write_text("schema_version = 1\n")
        env = {
            "PATH": str(bin_dir),
            "PYTHONPATH": str(root),
            # Match the owning account for native-default selection; only our
            # inert providers run, with private config/cache/state below root.
            "HOME": pwd.getpwuid(os.getuid()).pw_dir,
            "XDG_CONFIG_HOME": str(root / "config"),
            "XDG_CACHE_HOME": str(root / "cache"),
            "XDG_STATE_HOME": str(root / "state"),
            "PROOF_LOG": str(log),
            "CLAUDE_CONFIG_DIR": "/foreign/inherited/claude",
            "PYTHONDONTWRITEBYTECODE": "1",
        }

        def run(argv):
            result = subprocess.run(
                argv, cwd=root, env=env, capture_output=True, timeout=20, check=False
            )
            require(
                result.returncode == 0 and len(result.stdout) <= 2**20,
                "isolated candidate command failed: "
                + result.stderr.decode(errors="replace")[:500],
            )
            return json.loads(result.stdout)

        meta = run(
            [
                str(python),
                "-I",
                "-B",
                "-c",
                """import hashlib,importlib.metadata as m,json,sys,sysconfig
from pathlib import Path
import rofi_agent_plus
from rofi_agent_plus import host
assert 'rofi_agent_plus.desktop' not in sys.modules
assert not any(name.startswith(('agent_observer','tkinter','gi.','PyQt')) for name in sys.modules)
d=m.distribution('rofi-agent-plus')
site=Path(sysconfig.get_path('purelib'))
files={str(p):hashlib.sha256(Path(d.locate_file(p)).read_bytes()).hexdigest() for p in d.files if str(p).startswith('rofi_agent_plus/') and '__pycache__' not in str(p)}
print(json.dumps({'version':d.version,'requires':d.requires or [],'entries':{e.name:e.value for e in d.entry_points if e.group=='console_scripts'},'site':str(site),'package':str(rofi_agent_plus.__file__),'files':files,'distributions':sorted(x.metadata['Name'] for x in m.distributions())}))""",
            ]
        )
        require(Path(meta["site"]).is_relative_to(prefix), "interpreter escaped candidate prefix")
        require(Path(meta["package"]).is_relative_to(prefix), "checkout import")
        require(meta["entries"] == ENTRY_POINTS, "entry point mismatch")
        require(
            not any(
                "agent-observer" in item.lower() or "rofi-tmux" in item.lower()
                for item in meta["distributions"]
            ),
            "retired dependency installed",
        )
        require(
            not any("extra ==" not in item for item in meta["requires"]),
            "runtime dependency in metadata",
        )
        expected = {name: hashlib.sha256(raw).hexdigest() for name, raw in package.items()}
        require(meta["files"] == expected, "wheel/installed byte mismatch")
        for name in ENTRY_POINTS:
            require((prefix / "bin" / name).is_file(), "missing installed entry point")
        payload = run(
            [
                str(python),
                "-I",
                "-B",
                "-m",
                "rofi_agent_plus.host",
                "inventory",
                "--json",
                "--config",
                str(config),
            ]
        )
        require(
            payload["schemaVersion"] == 1 and len(payload["targets"]) == 2,
            "headless inventory shape",
        )
        require(
            payload["targets"][0]["daemon"]["status"] == "stopped",
            "stopped native environment missing",
        )
        calls = [json.loads(line) for line in log.read_text().splitlines()]
        require(
            payload["targets"][1]["key"]["provider"] == "claude"
            and payload["targets"][1]["daemon"]["status"] == "running",
            "native default Claude inventory failed",
        )
        require(
            calls
            == [
                ["agents", "--help"],
                ["app-server", "daemon", "version"],
                ["agents", "--help"],
                ["daemon", "status"],
            ],
            "inventory called entry or unexpected command",
        )
        # Exercise the installed console script itself, rather than only -m.
        again = run(
            [
                str(python),
                "-I",
                "-B",
                str(prefix / "bin/rofi-agent-plus-host"),
                "inventory",
                "--json",
                "--config",
                str(config),
            ]
        )
        require(
            [item["key"] for item in again["targets"]]
            == [item["key"] for item in payload["targets"]],
            "installed helper resolution mismatch",
        )
        receipt = {
            "outcome": "pass",
            "prefix": str(prefix),
            "wheel": str(wheel),
            "wheelSha256": hashlib.sha256(wheel.read_bytes()).hexdigest(),
            "version": meta["version"],
            "packageFiles": expected,
            "checks": {
                "isolatedImports": True,
                "wheelByteParity": True,
                "noRuntimeDependencies": True,
                "headlessControlledInventory": True,
                "installedEntryPoints": True,
            },
        }
        (output / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps({key: value for key, value in receipt.items() if key != "packageFiles"}))


def self_test():
    with tempfile.TemporaryDirectory() as temporary:
        path = Path(temporary) / "bad.whl"
        for name in ("../escape", "/escape", "rofi_agent_plus/observer_contract.py"):
            with zipfile.ZipFile(path, "w") as archive:
                archive.writestr(name, b"bad")
            try:
                wheel_files(path)
            except ValueError:
                pass
            else:
                raise AssertionError("unsafe/retired wheel accepted")
    print("artifact gate ownership/path negative checks passed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate-prefix", type=Path)
    parser.add_argument("--wheel", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if any(value is None for value in (args.candidate_prefix, args.wheel, args.output)):
        parser.error("candidate-prefix, wheel and output are required")
    inspect(args.candidate_prefix, args.wheel.resolve(), args.output.resolve())


if __name__ == "__main__":
    main()
