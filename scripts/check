#!/bin/sh
set -eu

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
ruff check .
ruff format --check .

test -x bin/rofi-agent-plus
test -x scripts/check
test -x scripts/check-contract-sync
test -f README.md
test -f LICENSE
test -f pyproject.toml
test -f examples/config.toml
test -f .github/workflows/ci.yml
test -f rofi_agent_plus/contract_backend.py
test -f rofi_agent_plus/contract_lifecycle.py
test -f tests/test_contract_backend.py
test -f tests/test_contract_lifecycle.py
test -f tests/fixtures/contract/README.md
test -f tests/fixtures/contract/lifecycle/README.md

# Check this gate itself even before the initial commit, then inspect every
# tracked or candidate-untracked shell file.  The latter is deliberately based
# on Git's combined file view instead of git ls-files alone.
shellcheck scripts/check
shellcheck scripts/check-contract-sync
git ls-files --cached --others --exclude-standard -- '*.sh' |
    while IFS= read -r shell_file; do
        [ -z "$shell_file" ] || shellcheck "$shell_file" || exit 1
    done

# git diff --check cannot see untracked files.  Scan the complete candidate
# view for the text-file invariants that matter before and after the first
# commit.  The scanner is read-only and skips binary files by NUL detection.
PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


paths = subprocess.run(
    ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
    check=True,
    capture_output=True,
    text=True,
).stdout.splitlines()
problems: list[str] = []
for name in paths:
    path = Path(name)
    if not path.exists():
        # A tracked path removed by an unstaged rename is not part of the
        # candidate working tree; the replacement path is listed separately.
        continue
    if path.suffix == ".bin":
        continue
    try:
        data = path.read_bytes()
    except OSError as exc:
        problems.append(f"{name}: cannot read candidate ({exc})")
        continue
    if b"\0" in data:
        continue
    if b"\r\n" in data:
        problems.append(f"{name}: CRLF line ending")
    if data and not data.endswith(b"\n"):
        problems.append(f"{name}: missing final newline")
    if data.endswith(b"\n\n"):
        problems.append(f"{name}: blank line at EOF")
    for number, line in enumerate(data.splitlines(), start=1):
        if line.endswith((b" ", b"\t")):
            problems.append(f"{name}:{number}: trailing whitespace")

if problems:
    print("candidate text-file check failed:", file=sys.stderr)
    print("\n".join(problems), file=sys.stderr)
    raise SystemExit(1)
PY

# Verify the vendored public bundles without needing a sibling checkout or a
# schema package.  The explicit sync gate compares bytes to producer trees.
PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'
from __future__ import annotations

import hashlib
import json
import re
from pathlib import Path


root = Path.cwd()
digest_pattern = re.compile(r"^sha256:[0-9a-f]{64}$", re.ASCII)
repositories = {
    "host-mesh-v1": "https://github.com/byebyebryan/rofi-ssh-plus",
    "tmux-session-v1": "https://github.com/byebyebryan/rofi-tmux-plus",
}
for contract in ("host-mesh-v1", "tmux-session-v1"):
    directory = root / "contracts" / contract
    manifest_path = directory / "SHA256SUMS"
    raw = manifest_path.read_bytes()
    if not raw.endswith(b"\n") or b"\r" in raw:
        raise SystemExit(f"{manifest_path}: malformed checksum bytes")
    entries: list[tuple[str, str]] = []
    for line in raw.splitlines():
        try:
            digest, name = line.decode("ascii").split("  ", 1)
        except (UnicodeDecodeError, ValueError) as error:
            raise SystemExit(f"{manifest_path}: malformed checksum line") from error
        if not re.fullmatch(r"[0-9a-f]{64}", digest, re.ASCII) or name == "SHA256SUMS":
            raise SystemExit(f"{manifest_path}: invalid checksum entry")
        entries.append((name, digest))
    names = [name for name, _digest in entries]
    if len(names) != len(set(names)) or names != sorted(names, key=lambda item: item.encode()):
        raise SystemExit(f"{manifest_path}: entries are not sorted and unique")
    for name, expected in entries:
        candidate = directory / name
        if not candidate.is_file() or hashlib.sha256(candidate.read_bytes()).hexdigest() != expected:
            raise SystemExit(f"{candidate}: checksum mismatch or missing")
    actual_files = {
        candidate.relative_to(directory).as_posix()
        for candidate in directory.rglob("*")
        if candidate.is_file()
        and candidate not in {directory / "SHA256SUMS", directory / "SOURCE.json"}
    }
    if actual_files != set(names):
        raise SystemExit(f"{directory}: SHA256SUMS coverage mismatch")
    source_path = directory / "SOURCE.json"
    try:
        source = json.loads(source_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise SystemExit(f"{source_path}: invalid SOURCE.json") from error
    if (
        not isinstance(source, dict)
        or source.get("contract") != contract
        or source.get("upstreamRepository") != repositories[contract]
        or source.get("sourceState") != "released"
    ):
        raise SystemExit(f"{source_path}: released provenance is required")
    if not re.fullmatch(r"[0-9a-f]{40}", str(source.get("sourceCommit"))) or not digest_pattern.fullmatch(
        str(source.get("bundleDigest"))
    ):
        raise SystemExit(f"{source_path}: invalid released provenance")
    expected_digest = f"sha256:{hashlib.sha256(raw).hexdigest()}"
    if source.get("bundleDigest") != expected_digest:
        raise SystemExit(f"{source_path}: bundle digest mismatch")
PY

# Keep Git's staged/unstaged checks as an additional guard once files are
# tracked or staged; they are intentionally redundant after the candidate scan.
git diff --check
git diff --cached --check

if find . -type d -name __pycache__ -print -quit | grep -q .; then
    echo "unexpected __pycache__ directory" >&2
    exit 1
fi
